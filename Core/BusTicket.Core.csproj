<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Cœur métier partagé par le serveur (Server/BusTicket.Api) et l'application MAUI :
		modèles échangés, catalogue des trajets, règles de réservation, signature des billets, PDF.
		Aucune dépendance à MAUI ni à ASP.NET : le même code tourne côté serveur et, hors ligne, sur le téléphone.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>BusTicket.Core</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="QRCoder" Version="1.6.0" />
	</ItemGroup>

</Project>
