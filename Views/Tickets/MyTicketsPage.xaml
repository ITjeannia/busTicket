<?xml version="1.0" encoding="utf-8" ?>
<!-- Onglet « Mes billets » : à venir / passés, tirer pour actualiser. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:BusTicket.Controls"
             xmlns:h="clr-namespace:BusTicket.Helpers"
             xmlns:items="clr-namespace:BusTicket.ViewModels.Items"
             xmlns:t="clr-namespace:BusTicket.Theme"
             xmlns:vm="clr-namespace:BusTicket.ViewModels"
             x:Class="BusTicket.Views.Tickets.MyTicketsPage"
             x:DataType="vm:MyTicketsViewModel"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Style="{StaticResource HeaderBand}" Padding="20,44,20,20" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="Mes billets" Style="{StaticResource Headline}" TextColor="White" />
                <Label Text="{Binding CountText}" Style="{StaticResource OnPrimaryMuted}" />
            </VerticalStackLayout>
            <Border Grid.Column="1" Style="{StaticResource IconTile}" BackgroundColor="{x:Static t:AppColors.PrimaryDark}"
                    WidthRequest="44" HeightRequest="44">
                <Label Text="{x:Static h:MaterialIcons.Ticket}" Style="{StaticResource Icon}" TextColor="White" />
            </Border>
        </Grid>

        <VerticalStackLayout Grid.Row="1" Padding="16,12,16,4" Spacing="12" BackgroundColor="White">
            <c:SegmentedTabs Items="{Binding TabLabels}" SelectedIndex="{Binding SelectedTab}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding ReloadCommand}"
                     IsVisible="{Binding HasTickets}">
            <CollectionView ItemsSource="{Binding Tickets}" SelectionMode="None">
                <CollectionView.Header>
                    <VerticalStackLayout Padding="16,16,16,4" Spacing="12">
                        <c:OfflineBanner />
                        <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsUpcoming}">
                            <Label Text="{x:Static h:MaterialIcons.CloudDone}" Style="{StaticResource Icon}" FontSize="16" />
                            <Label Text="Vos billets restent disponibles sans connexion." Style="{StaticResource Small}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="items:TicketItem">
                        <ContentView Padding="16,6">
                            <Border Style="{StaticResource Card}" Padding="0"
                                    c:Motion.Entrance="FadeUp" c:Motion.Delay="{Binding EntranceDelay}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenTicketCommand, Source={RelativeSource AncestorType={x:Type vm:MyTicketsViewModel}}, x:DataType=vm:MyTicketsViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto,84">
                                    <!-- Partie gauche : trajet -->
                                    <VerticalStackLayout Padding="16,14" Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding DateText}" Style="{StaticResource Overline}"
                                                   TextColor="{x:Static t:AppColors.Primary}" />
                                            <Label Grid.Column="1" Text="{Binding Countdown}" Style="{StaticResource Small}"
                                                   FontFamily="RobotoMedium" TextColor="{x:Static t:AppColors.Primary}"
                                                   IsVisible="{Binding HasCountdown}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSoon}" Value="True">
                                                        <Setter Property="TextColor" Value="{x:Static t:AppColors.Warning}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout>
                                                <Label Text="{Binding DepartureTime}" Style="{StaticResource TripTime}" FontSize="18" />
                                                <Label Text="{Binding From}" Style="{StaticResource Small}" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{x:Static h:MaterialIcons.ArrowForward}" Style="{StaticResource Icon}"
                                                   FontSize="16" TextColor="{x:Static t:AppColors.Disabled}" />
                                            <VerticalStackLayout Grid.Column="2">
                                                <HorizontalStackLayout HorizontalOptions="End" Spacing="2">
                                                    <Label Text="{Binding ArrivalTime}" Style="{StaticResource TripTime}" FontSize="18" />
                                                    <Label Text="+1 j" Style="{StaticResource Small}" FontSize="10" FontFamily="RobotoMedium"
                                                           TextColor="{x:Static t:AppColors.Warning}" VerticalOptions="Start"
                                                           IsVisible="{Binding ArrivesNextDay}" />
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding To}" Style="{StaticResource Small}" HorizontalOptions="End" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Label Text="{Binding Details}" Style="{StaticResource Small}" LineBreakMode="TailTruncation" />
                                        <c:StatusChip Kind="{Binding Status}" />
                                    </VerticalStackLayout>

                                    <!-- Perforation -->
                                    <c:DashedLine Grid.Column="1" Vertical="True" WidthRequest="2" Margin="0,10" />

                                    <!-- Talon : QR -->
                                    <BoxView Grid.Column="2" Color="{x:Static t:AppColors.PrimarySoft}" />
                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="4" Padding="0,16">
                                        <Label Text="{x:Static h:MaterialIcons.QrCode}" Style="{StaticResource Icon}" FontSize="40"
                                               TextColor="{x:Static t:AppColors.Primary}" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="TextColor" Value="{x:Static t:AppColors.Disabled}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding Reference}" Style="{StaticResource Small}" FontSize="11" FontFamily="RobotoMedium"
                                               HorizontalOptions="Center" />
                                        <Label Text="{Binding PriceText}" Style="{StaticResource Small}" FontSize="11"
                                               HorizontalOptions="Center" TextColor="{x:Static t:AppColors.TextPrimary}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </ContentView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView HeightRequest="24" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <c:EmptyState Grid.Row="2" IsVisible="{Binding IsEmpty}"
                      Illustration="illus_tickets.png"
                      Title="{Binding EmptyTitle}"
                      Message="{Binding EmptyMessage}"
                      ActionText="{Binding EmptyActionText}"
                      ActionCommand="{Binding GoToSearchCommand}" />
    </Grid>
</ContentPage>
