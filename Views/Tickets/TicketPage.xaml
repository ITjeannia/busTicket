<?xml version="1.0" encoding="utf-8" ?>
<!-- Maquettes 08 (billet valide avec QR code) et 08b (billet expiré). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:BusTicket.Controls"
             xmlns:h="clr-namespace:BusTicket.Helpers"
             xmlns:t="clr-namespace:BusTicket.Theme"
             xmlns:vm="clr-namespace:BusTicket.ViewModels"
             x:Class="BusTicket.Views.Tickets.TicketPage"
             x:DataType="vm:TicketViewModel"
             Title="Mon billet"
             Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <c:AlertBanner Kind="Error" Message="{Binding ExpiredMessage}" />

            <!-- Le billet -->
            <Border Stroke="{x:Static t:AppColors.Border}" StrokeShape="RoundRectangle 12" Padding="0">
                <VerticalStackLayout>
                    <VerticalStackLayout Padding="16" Spacing="4" BackgroundColor="{x:Static t:AppColors.Primary}">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsExpired}" Value="True">
                                <Setter Property="BackgroundColor" Value="{x:Static t:AppColors.Disabled}" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>
                        <Label Text="{Binding Route}" Style="{StaticResource TicketHeader}" FontSize="20" FontFamily="RobotoBold">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsExpired}" Value="True">
                                    <Setter Property="TextColor" Value="{x:Static t:AppColors.TextPrimary}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="{Binding DateLine}" Style="{StaticResource TicketHeader}" FontSize="14">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsExpired}" Value="True">
                                    <Setter Property="TextColor" Value="{x:Static t:AppColors.TextPrimary}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>

                    <VerticalStackLayout Padding="16" Spacing="16">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="Passager" Style="{StaticResource Caption}" />
                                <Label Text="{Binding Passenger}" Style="{StaticResource Subtitle}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Compagnie" Style="{StaticResource Caption}" />
                                <Label Text="{Binding Company}" Style="{StaticResource Subtitle}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1">
                                <Label Text="{Binding SeatLabel}" Style="{StaticResource Caption}" />
                                <Label Text="{Binding SeatValue}" Style="{StaticResource Subtitle}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                <Label Text="Réservation" Style="{StaticResource Caption}" />
                                <Label Text="{Binding Reference}" Style="{StaticResource Subtitle}" />
                            </VerticalStackLayout>
                        </Grid>

                        <c:DashedLine />

                        <Image Source="{Binding QrCode}" WidthRequest="170" HeightRequest="170"
                               HorizontalOptions="Center" SemanticProperties.Description="QR code du billet" />
                        <Label Text="{Binding CodeCaption}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                <c:StatusChip Kind="Valid" IsVisible="{Binding IsValid}" />
                <c:StatusChip Kind="Neutral" Text="Disponible hors ligne" Icon="{x:Static h:MaterialIcons.Download}"
                              IsVisible="{Binding IsValid}" />
                <c:StatusChip Kind="Expired" IsVisible="{Binding IsExpired}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
