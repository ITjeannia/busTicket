<?xml version="1.0" encoding="utf-8" ?>
<!-- Connexion : en-tête illustré + carte de formulaire. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:BusTicket.Controls"
             xmlns:h="clr-namespace:BusTicket.Helpers"
             xmlns:t="clr-namespace:BusTicket.Theme"
             xmlns:vm="clr-namespace:BusTicket.ViewModels"
             x:Class="BusTicket.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <Grid RowDefinitions="Auto,Auto">
                <!-- En-tête bleu illustré -->
                <Grid Style="{StaticResource HeaderBand}" RowDefinitions="Auto,Auto,Auto,Auto" Padding="20,44,20,0">
                    <HorizontalStackLayout Spacing="10" c:Motion.Entrance="Fade">
                        <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                BackgroundColor="White">
                            <Label Text="{x:Static h:MaterialIcons.BusFilled}" Style="{StaticResource Icon}" FontSize="22"
                                   TextColor="{x:Static t:AppColors.Primary}" />
                        </Border>
                        <Label Text="BusTicket" Style="{StaticResource Brand}" TextColor="White" />
                    </HorizontalStackLayout>

                    <Label Grid.Row="1" Text="Voyagez partout au Cameroun" Style="{StaticResource Headline}"
                           TextColor="White" Margin="0,24,0,6"
                           c:Motion.Entrance="FadeUp" c:Motion.Delay="80" />
                    <Label Grid.Row="2" Text="Réservez votre siège, payez en Mobile Money et embarquez avec votre billet sur le téléphone."
                           Style="{StaticResource OnPrimaryMuted}" LineHeight="1.25"
                           c:Motion.Entrance="FadeUp" c:Motion.Delay="140" />

                    <Image Grid.Row="3" Source="illus_hero.png" Aspect="AspectFit"
                           HeightRequest="120" Margin="-20,12,-20,36"
                           c:Motion.Entrance="SlideLeft" c:Motion.Delay="200" />
                </Grid>

                <!-- Formulaire -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="16,-28,16,16"
                        c:Motion.Entrance="FadeUp" c:Motion.Delay="160">
                    <VerticalStackLayout x:Name="Form" Spacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Connexion" Style="{StaticResource Title}" />
                            <Label Text="Retrouvez vos billets sur tous vos appareils." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>

                        <c:AlertBanner Kind="Error" Message="{Binding BannerError}" />

                        <c:AppTextField Label="E-mail ou téléphone"
                                        Placeholder="Votre e-mail ou numéro"
                                        Icon="{x:Static h:MaterialIcons.Mail}"
                                        Keyboard="Email"
                                        ReturnType="Next"
                                        Text="{Binding Identifier}"
                                        ErrorText="{Binding IdentifierError}"
                                        IsEnabled="{Binding IsIdle}" />

                        <c:AppTextField Label="Mot de passe"
                                        Icon="{x:Static h:MaterialIcons.Lock}"
                                        IsPassword="True"
                                        ReturnType="Go"
                                        ReturnCommand="{Binding LoginCommand}"
                                        Text="{Binding Password}"
                                        ErrorText="{Binding PasswordError}"
                                        IsEnabled="{Binding IsIdle}" />

                        <Label Text="Mot de passe oublié ?" Style="{StaticResource Link}" FontSize="14"
                               HorizontalOptions="End" Margin="0,-6,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <c:AppButton Text="Se connecter"
                                     Icon="{x:Static h:MaterialIcons.ArrowForward}"
                                     LoadingText="Connexion…"
                                     IsLoading="{Binding IsLoading}"
                                     Command="{Binding LoginCommand}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>

        <HorizontalStackLayout Grid.Row="1" HorizontalOptions="Center" Spacing="6" Padding="0,8,0,20">
            <Label Text="Pas encore de compte ?" Style="{StaticResource BodySecondary}" FontSize="15" />
            <Label Text="Créer un compte" Style="{StaticResource Link}" FontSize="15">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
