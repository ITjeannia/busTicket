<?xml version="1.0" encoding="utf-8" ?>
<!-- Création de compte : le bouton reste grisé tant que tout n'est pas rempli et accepté. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:BusTicket.Controls"
             xmlns:h="clr-namespace:BusTicket.Helpers"
             xmlns:t="clr-namespace:BusTicket.Theme"
             xmlns:vm="clr-namespace:BusTicket.ViewModels"
             x:Class="BusTicket.Views.Auth.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Créer un compte"
             Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" c:Motion.Entrance="FadeUp">
                <Border Style="{StaticResource IconTile}" WidthRequest="48" HeightRequest="48">
                    <Label Text="{x:Static h:MaterialIcons.Badge}" Style="{StaticResource Icon}" FontSize="24"
                           TextColor="{x:Static t:AppColors.Primary}" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Bienvenue à bord" Style="{StaticResource Section}" />
                    <Label Text="Quelques informations pour émettre vos billets à votre nom." Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Grid>

            <c:AlertBanner Kind="Error" Message="{Binding BannerError}" />

            <Border Style="{StaticResource Card}" Padding="16" c:Motion.Entrance="FadeUp" c:Motion.Delay="80">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Identité" Style="{StaticResource Overline}" />
                    <c:AppTextField Label="Nom complet" Placeholder="Prénom et nom" ReturnType="Next"
                                    Icon="{x:Static h:MaterialIcons.Person}"
                                    Text="{Binding FullName}" ErrorText="{Binding FullNameError}"
                                    HelperText="Tel qu'il figure sur votre pièce d'identité" />

                    <c:AppTextField Label="E-mail" Placeholder="nom@exemple.com" Keyboard="Email" ReturnType="Next"
                                    Icon="{x:Static h:MaterialIcons.Mail}"
                                    Text="{Binding Email}" ErrorText="{Binding EmailError}" />

                    <c:AppTextField Label="Téléphone" Placeholder="6XX XX XX XX" Keyboard="Telephone" ReturnType="Next"
                                    Icon="{x:Static h:MaterialIcons.Phone}"
                                    Text="{Binding Phone}" ErrorText="{Binding PhoneError}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16" c:Motion.Entrance="FadeUp" c:Motion.Delay="140">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Sécurité" Style="{StaticResource Overline}" />
                    <c:AppTextField Label="Mot de passe" IsPassword="True" ReturnType="Next"
                                    Icon="{x:Static h:MaterialIcons.Lock}"
                                    HelperText="8 caractères minimum, dont 1 chiffre"
                                    Text="{Binding Password}" ErrorText="{Binding PasswordError}" />

                    <c:AppTextField Label="Confirmer le mot de passe" Placeholder="Ressaisir le mot de passe" IsPassword="True" ReturnType="Done"
                                    Icon="{x:Static h:MaterialIcons.Lock}"
                                    Text="{Binding Confirm}" ErrorText="{Binding ConfirmError}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                <CheckBox IsChecked="{Binding AcceptedTerms}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="J'accepte les conditions générales de vente et de transport"
                       Style="{StaticResource Caption}" TextColor="{x:Static t:AppColors.TextPrimary}" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleTermsCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <c:AppButton Text="Créer mon compte"
                         LoadingText="Création du compte…"
                         IsEnabled="{Binding CanSubmit}"
                         IsLoading="{Binding IsLoading}"
                         Command="{Binding CreateAccountCommand}" />

            <Label Text="Remplissez tous les champs et acceptez les conditions pour continuer."
                   Style="{StaticResource Small}" HorizontalTextAlignment="Center"
                   IsVisible="{Binding ShowSubmitHint}" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,0,0,8">
                <Label Text="Déjà inscrit ?" Style="{StaticResource BodySecondary}" FontSize="15" />
                <Label Text="Se connecter" Style="{StaticResource Link}" FontSize="15">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
