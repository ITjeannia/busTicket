<?xml version="1.0" encoding="utf-8" ?>
<!-- Choix des sièges : un par passager. Plan du bus vu de dessus, avant en haut. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:b="clr-namespace:BusTicket.Views.Booking"
             xmlns:c="clr-namespace:BusTicket.Controls"
             xmlns:h="clr-namespace:BusTicket.Helpers"
             xmlns:items="clr-namespace:BusTicket.ViewModels.Items"
             xmlns:t="clr-namespace:BusTicket.Theme"
             xmlns:vm="clr-namespace:BusTicket.ViewModels"
             x:Class="BusTicket.Views.Booking.SeatSelectionPage"
             x:DataType="vm:SeatSelectionViewModel"
             Title="Choisir vos sièges"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">
                <!-- Rappel du trajet -->
                <Border Style="{StaticResource Card}" Padding="14,12" c:Motion.Entrance="FadeUp">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Style="{StaticResource IconTile}">
                            <Label Text="{x:Static h:MaterialIcons.Bus}" Style="{StaticResource Icon}"
                                   TextColor="{x:Static t:AppColors.Primary}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{Binding Route}" Style="{StaticResource Value}" />
                            <Label Text="{Binding TripInfo}" Style="{StaticResource Small}" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding CompanyLine}" Style="{StaticResource Small}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Légende -->
                <Grid ColumnDefinitions="*,*,*" c:Motion.Entrance="Fade" c:Motion.Delay="80">
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Border Style="{StaticResource LegendBox}" />
                        <Label Text="Libre" Style="{StaticResource Small}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="Center">
                        <Border Style="{StaticResource LegendBox}" BackgroundColor="{x:Static t:AppColors.Primary}"
                                Stroke="{x:Static t:AppColors.Primary}" />
                        <Label Text="Votre choix" Style="{StaticResource Small}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="2" Spacing="8" HorizontalOptions="Center">
                        <Border Style="{StaticResource LegendBox}" BackgroundColor="{x:Static t:AppColors.SurfaceMuted}"
                                Stroke="{x:Static t:AppColors.Divider}">
                            <Label Text="{x:Static h:MaterialIcons.Close}" Style="{StaticResource Icon}" FontSize="11"
                                   TextColor="{x:Static t:AppColors.TextDisabled}" />
                        </Border>
                        <Label Text="Occupé" Style="{StaticResource Small}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Plan du bus -->
                <Border StrokeShape="RoundRectangle 36,36,10,10" Stroke="{x:Static t:AppColors.Border}" StrokeThickness="2"
                        BackgroundColor="White" Padding="18,16,18,20" HorizontalOptions="Center" WidthRequest="278"
                        c:Motion.Entrance="FadeUp" c:Motion.Delay="120">
                    <VerticalStackLayout Spacing="10">
                        <!-- Avant : conducteur à gauche, porte à droite -->
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,6">
                            <Border WidthRequest="42" HeightRequest="42" StrokeShape="RoundRectangle 21" StrokeThickness="0"
                                    BackgroundColor="{x:Static t:AppColors.SurfaceMuted}" HorizontalOptions="Start">
                                <Label Text="{x:Static h:MaterialIcons.Person}" Style="{StaticResource Icon}" FontSize="20" />
                            </Border>
                            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="4">
                                <Label Text="Porte" Style="{StaticResource Small}" VerticalOptions="Center" />
                                <BoxView WidthRequest="4" HeightRequest="30" CornerRadius="2" Color="{x:Static t:AppColors.Primary}" />
                            </HorizontalStackLayout>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" Margin="0,0,0,6" />

                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Rows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="items:SeatRow">
                                    <Grid ColumnDefinitions="42,42,34,42,42" ColumnSpacing="8" HorizontalOptions="Center">
                                        <b:SeatView Grid.Column="0" Seat="{Binding LeftWindow}" Command="{Binding ToggleSeatCommand, Source={RelativeSource AncestorType={x:Type vm:SeatSelectionViewModel}}, x:DataType=vm:SeatSelectionViewModel}" />
                                        <b:SeatView Grid.Column="1" Seat="{Binding LeftAisle}" Command="{Binding ToggleSeatCommand, Source={RelativeSource AncestorType={x:Type vm:SeatSelectionViewModel}}, x:DataType=vm:SeatSelectionViewModel}" />
                                        <b:SeatView Grid.Column="3" Seat="{Binding RightAisle}" Command="{Binding ToggleSeatCommand, Source={RelativeSource AncestorType={x:Type vm:SeatSelectionViewModel}}, x:DataType=vm:SeatSelectionViewModel}" />
                                        <b:SeatView Grid.Column="4" Seat="{Binding RightWindow}" Command="{Binding ToggleSeatCommand, Source={RelativeSource AncestorType={x:Type vm:SeatSelectionViewModel}}, x:DataType=vm:SeatSelectionViewModel}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                    <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" WidthRequest="14" HeightRequest="14" />
                    <Label Text="{Binding AvailabilityText}" Style="{StaticResource Small}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Barre du bas : résumé + Continuer -->
        <Border Grid.Row="1" Style="{StaticResource BottomBar}">
            <Grid ColumnDefinitions="*,150" ColumnSpacing="12">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="{Binding Summary}" Style="{StaticResource Small}" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding PriceText}" Style="{StaticResource TripTime}" TextColor="{x:Static t:AppColors.Primary}" />
                </VerticalStackLayout>
                <c:AppButton Grid.Column="1" Text="Continuer" IsEnabled="{Binding CanContinue}"
                             Command="{Binding ContinueCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
