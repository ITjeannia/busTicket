<?xml version="1.0" encoding="utf-8" ?>
<!-- Maquette 05 — un siège par passager. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:b="clr-namespace:BusTicket.Views.Booking"
             xmlns:c="clr-namespace:BusTicket.Controls"
             xmlns:h="clr-namespace:BusTicket.Helpers"
             xmlns:items="clr-namespace:BusTicket.ViewModels.Items"
             xmlns:t="clr-namespace:BusTicket.Theme"
             xmlns:vm="clr-namespace:BusTicket.ViewModels"
             x:Class="BusTicket.Views.Booking.SeatSelectionPage"
             x:DataType="vm:SeatSelectionViewModel"
             Title="Choisir un siège"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">
                <!-- Rappel du trajet -->
                <Border Style="{StaticResource MutedBox}" Padding="12,10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="{x:Static h:MaterialIcons.Bus}" Style="{StaticResource Icon}" FontSize="18" />
                        <Label Grid.Column="1" Text="{Binding TripInfo}" Style="{StaticResource Caption}"
                               LineBreakMode="TailTruncation" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Légende -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="16">
                    <HorizontalStackLayout Spacing="8">
                        <Border Style="{StaticResource LegendBox}" />
                        <Label Text="Libre" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="8">
                        <Border Style="{StaticResource LegendBox}" BackgroundColor="{x:Static t:AppColors.Primary}"
                                Stroke="{x:Static t:AppColors.Primary}" />
                        <Label Text="Votre siège" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="8">
                        <Border Style="{StaticResource LegendBox}" BackgroundColor="{x:Static t:AppColors.Disabled}"
                                Stroke="{x:Static t:AppColors.Disabled}">
                            <Label Text="{x:Static h:MaterialIcons.Close}" Style="{StaticResource Icon}" FontSize="12" />
                        </Border>
                        <Label Text="Occupé" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </HorizontalStackLayout>

                <!-- Plan du bus : 2 sièges + allée + 2 sièges -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <Label Text="Avant du bus" Style="{StaticResource Caption}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{x:Static h:MaterialIcons.Bus}" Style="{StaticResource Icon}" />
                        </Grid>
                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Rows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="items:SeatRow">
                                    <Grid ColumnDefinitions="44,44,40,44,44" ColumnSpacing="8" HorizontalOptions="Center">
                                        <b:SeatView Grid.Column="0" Seat="{Binding LeftWindow}" Command="{Binding ToggleSeatCommand, Source={RelativeSource AncestorType={x:Type vm:SeatSelectionViewModel}}, x:DataType=vm:SeatSelectionViewModel}" />
                                        <b:SeatView Grid.Column="1" Seat="{Binding LeftAisle}" Command="{Binding ToggleSeatCommand, Source={RelativeSource AncestorType={x:Type vm:SeatSelectionViewModel}}, x:DataType=vm:SeatSelectionViewModel}" />
                                        <b:SeatView Grid.Column="3" Seat="{Binding RightAisle}" Command="{Binding ToggleSeatCommand, Source={RelativeSource AncestorType={x:Type vm:SeatSelectionViewModel}}, x:DataType=vm:SeatSelectionViewModel}" />
                                        <b:SeatView Grid.Column="4" Seat="{Binding RightWindow}" Command="{Binding ToggleSeatCommand, Source={RelativeSource AncestorType={x:Type vm:SeatSelectionViewModel}}, x:DataType=vm:SeatSelectionViewModel}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Barre du bas : résumé + Continuer -->
        <Border Grid.Row="1" Style="{StaticResource BottomBar}">
            <Grid ColumnDefinitions="*,156" ColumnSpacing="12">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="{Binding Summary}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding PriceText}" Style="{StaticResource TripTime}" FontSize="22" />
                </VerticalStackLayout>
                <c:AppButton Grid.Column="1" Text="Continuer" IsEnabled="{Binding CanContinue}"
                             Command="{Binding ContinueCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
