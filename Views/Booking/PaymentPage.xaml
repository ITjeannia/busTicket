<?xml version="1.0" encoding="utf-8" ?>
<!-- Paiement (simulé, toujours accepté) : récapitulatif, passager, moyen de paiement, traitement en 3 étapes. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:BusTicket.Controls"
             xmlns:h="clr-namespace:BusTicket.Helpers"
             xmlns:t="clr-namespace:BusTicket.Theme"
             xmlns:vm="clr-namespace:BusTicket.ViewModels"
             x:Class="BusTicket.Views.Booking.PaymentPage"
             x:DataType="vm:PaymentViewModel"
             Title="Paiement"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
        <ScrollView x:Name="Scroller">
            <VerticalStackLayout Padding="16" Spacing="16">
                <c:AlertBanner Kind="Error" Message="{Binding ErrorMessage}" />

                <!-- Récapitulatif -->
                <Border Style="{StaticResource Card}" Padding="0" c:Motion.Entrance="FadeUp">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" Padding="16,14" BackgroundColor="{x:Static t:AppColors.Primary}">
                            <VerticalStackLayout>
                                <Label Text="{Binding Route}" Style="{StaticResource Section}" TextColor="White" />
                                <Label Text="{Binding TripDate}" Style="{StaticResource OnPrimaryMuted}" FontSize="13" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding TripTimes}" FontFamily="RobotoBold" FontSize="16" TextColor="White"
                                   VerticalOptions="Center" />
                        </Grid>
                        <VerticalStackLayout Padding="16,10,16,8">
                            <Label Text="{Binding TripDetails}" Style="{StaticResource Small}" Margin="0,0,0,6" />
                            <BoxView Style="{StaticResource Divider}" Margin="0,0,0,4" />
                            <c:InfoRow Label="{Binding TicketLabel}" Value="{Binding TicketPrice}" />
                            <c:InfoRow Label="Frais de service" Value="{Binding FeeText}" />
                            <BoxView Style="{StaticResource Divider}" Margin="0,4" />
                            <c:InfoRow Label="Total à payer" Value="{Binding TotalText}" IsTotal="True" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Passager -->
                <Label Text="Passager" Style="{StaticResource Section}" Margin="0,4,0,0" />
                <c:AppTextField Label="Nom sur le billet" Placeholder="Jean Dupont"
                                Icon="{x:Static h:MaterialIcons.Person}"
                                Text="{Binding PassengerName}" ErrorText="{Binding PassengerError}"
                                HelperText="Le contrôleur peut demander une pièce d'identité à ce nom."
                                IsEnabled="{Binding IsIdle}" />

                <!-- Moyen de paiement -->
                <Label Text="Moyen de paiement" Style="{StaticResource Section}" Margin="0,4,0,0" />
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Options}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PaymentOption">
                            <c:OptionTile Title="{Binding Method.Label}"
                                          Description="{Binding Method.Description}"
                                          Icon="{Binding Method.Icon}"
                                          Accent="{Binding Method.Accent}"
                                          IsSelected="{Binding IsSelected}"
                                          IsEnabled="{Binding IsIdle, Source={RelativeSource AncestorType={x:Type vm:PaymentViewModel}}, x:DataType=vm:PaymentViewModel}"
                                          Command="{Binding SelectMethodCommand, Source={RelativeSource AncestorType={x:Type vm:PaymentViewModel}}, x:DataType=vm:PaymentViewModel}"
                                          CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <c:AppTextField x:Name="AccountField"
                                Label="{Binding FieldLabel}"
                                Placeholder="{Binding FieldPlaceholder}"
                                Icon="{Binding FieldIcon}"
                                Keyboard="{Binding FieldKeyboard}"
                                Text="{Binding AccountNumber}"
                                ErrorText="{Binding FieldError}"
                                HelperText="{Binding FieldHelp}"
                                IsEnabled="{Binding IsIdle}" />
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" Style="{StaticResource BottomBar}">
            <VerticalStackLayout Spacing="10">
                <c:AppButton Text="{Binding PayButtonText}"
                             Icon="{x:Static h:MaterialIcons.Lock}"
                             LoadingText="Paiement en cours…"
                             IsLoading="{Binding IsPaying}"
                             Command="{Binding PayCommand}" />
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label Text="{x:Static h:MaterialIcons.Shield}" Style="{StaticResource Icon}" FontSize="14" />
                    <Label Text="Paiement sécurisé · billet et reçu émis immédiatement" Style="{StaticResource Small}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Traitement du paiement -->
        <Grid x:Name="Processing" Grid.RowSpan="2" IsVisible="False" BackgroundColor="#99000000">
            <Border x:Name="ProcessingCard" Style="{StaticResource Card}" Padding="24" Margin="28,0"
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="18">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Paiement en cours" Style="{StaticResource Title}" HorizontalOptions="Center" />
                        <Label Text="{Binding TotalText}" FontFamily="RobotoBold" FontSize="26"
                               TextColor="{x:Static t:AppColors.Primary}" HorizontalOptions="Center" />
                        <Label Text="Ne fermez pas l'application." Style="{StaticResource Small}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <BoxView Style="{StaticResource Divider}" />
                    <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Steps}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PaymentStep">
                                <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                                    <Ellipse WidthRequest="20" HeightRequest="20" Stroke="{x:Static t:AppColors.Border}" StrokeThickness="2"
                                             IsVisible="{Binding IsPending}" />
                                    <ActivityIndicator WidthRequest="22" HeightRequest="22" IsRunning="{Binding IsActive}"
                                                       IsVisible="{Binding IsActive}" />
                                    <Label Text="{x:Static h:MaterialIcons.CheckCircleFilled}" Style="{StaticResource Icon}" FontSize="24"
                                           TextColor="{x:Static t:AppColors.Success}" IsVisible="{Binding IsDone}" />
                                    <Label Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Body}" FontSize="15" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsPending}" Value="True">
                                                <Setter Property="TextColor" Value="{x:Static t:AppColors.TextDisabled}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="FontFamily" Value="RobotoMedium" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
