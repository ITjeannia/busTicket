<?xml version="1.0" encoding="utf-8" ?>
<!-- Liste des départs : chargement, liste, aucun départ, erreur. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:BusTicket.Controls"
             xmlns:h="clr-namespace:BusTicket.Helpers"
             xmlns:items="clr-namespace:BusTicket.ViewModels.Items"
             xmlns:t="clr-namespace:BusTicket.Theme"
             xmlns:vm="clr-namespace:BusTicket.ViewModels"
             x:Class="BusTicket.Views.Search.ResultsPage"
             x:DataType="vm:ResultsViewModel"
             Title="{Binding Title}"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Rappel de la recherche + jours -->
        <VerticalStackLayout BackgroundColor="White" Padding="16,4,16,12" Spacing="10">
            <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
            <c:SegmentedTabs Items="{Binding DayLabels}" SelectedIndex="{Binding SelectedDayIndex}" />
        </VerticalStackLayout>
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <!-- Chargement -->
        <VerticalStackLayout Grid.Row="2" Padding="16" Spacing="12" IsVisible="{Binding IsLoading}">
            <HorizontalStackLayout Spacing="8">
                <ActivityIndicator IsRunning="{Binding IsLoading}" WidthRequest="16" HeightRequest="16" />
                <Label Text="Recherche des départs disponibles…" Style="{StaticResource Caption}" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <c:SkeletonCard />
            <c:SkeletonCard />
            <c:SkeletonCard />
        </VerticalStackLayout>

        <!-- Liste des départs -->
        <CollectionView Grid.Row="2" IsVisible="{Binding IsLoaded}" ItemsSource="{Binding Trips}" SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Padding="16,16,16,4" Spacing="12">
                    <c:OfflineBanner />
                    <Label Text="{Binding CountText}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="items:TripItem">
                    <ContentView Padding="16,6">
                        <Border Style="{StaticResource Card}" Padding="0"
                                c:Motion.Entrance="FadeUp" c:Motion.Delay="{Binding EntranceDelay}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsFull}" Value="True">
                                    <Setter Property="Opacity" Value="0.6" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenTripCommand, Source={RelativeSource AncestorType={x:Type vm:ResultsViewModel}}, x:DataType=vm:ResultsViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout>
                                <VerticalStackLayout Padding="16,14,16,12" Spacing="12">
                                    <!-- Compagnie, classe, prix -->
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Company}" Style="{StaticResource Value}" FontSize="15" VerticalOptions="Center" />
                                        <c:StatusChip Grid.Column="1" Kind="Info" Text="VIP" Icon="{x:Static h:MaterialIcons.Star}"
                                                      IsVisible="{Binding IsVip}" />
                                        <c:StatusChip Grid.Column="1" Kind="Neutral" Text="{Binding ServiceClass}"
                                                      IsVisible="{Binding IsClassic}" />
                                        <Label Grid.Column="3" Text="{Binding PriceText}" Style="{StaticResource TripTime}" FontSize="18"
                                               TextColor="{x:Static t:AppColors.Primary}" />
                                    </Grid>

                                    <!-- Horaires -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding DepartureTime}" Style="{StaticResource TripTime}" />
                                            <Label Text="{Binding From}" Style="{StaticResource Small}" />
                                        </VerticalStackLayout>
                                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto" VerticalOptions="Center">
                                            <Label Text="{Binding DurationText}" Style="{StaticResource Small}" FontFamily="RobotoMedium"
                                                   HorizontalOptions="Center" />
                                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                                                <Ellipse WidthRequest="8" HeightRequest="8" Stroke="{x:Static t:AppColors.Primary}"
                                                         StrokeThickness="2" VerticalOptions="Center" />
                                                <c:DashedLine Grid.Column="1" VerticalOptions="Center" Margin="2,0" />
                                                <Ellipse Grid.Column="2" WidthRequest="8" HeightRequest="8" Fill="{x:Static t:AppColors.Primary}"
                                                         VerticalOptions="Center" />
                                            </Grid>
                                            <Label Grid.Row="2" Text="{Binding StopsText}" Style="{StaticResource Small}" HorizontalOptions="Center" />
                                        </Grid>
                                        <VerticalStackLayout Grid.Column="2">
                                            <Label Text="{Binding ArrivalTime}" Style="{StaticResource TripTime}" HorizontalOptions="End" />
                                            <Label Text="{Binding To}" Style="{StaticResource Small}" HorizontalOptions="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- Équipements et places -->
                                <Grid ColumnDefinitions="*,Auto" Padding="16,10" BackgroundColor="{x:Static t:AppColors.SurfaceMuted}">
                                    <HorizontalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding AmenityIcons}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Label Text="{Binding .}" Style="{StaticResource Icon}" FontSize="17" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="{x:Static h:MaterialIcons.Seat}" Style="{StaticResource Icon}" FontSize="16"
                                               TextColor="{x:Static t:AppColors.Success}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsAlmostFull}" Value="True">
                                                    <Setter Property="TextColor" Value="{x:Static t:AppColors.Warning}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsFull}" Value="True">
                                                    <Setter Property="TextColor" Value="{x:Static t:AppColors.TextSecondary}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding SeatsText}" Style="{StaticResource Small}" FontFamily="RobotoMedium"
                                               TextColor="{x:Static t:AppColors.Success}" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsAlmostFull}" Value="True">
                                                    <Setter Property="TextColor" Value="{x:Static t:AppColors.Warning}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsFull}" Value="True">
                                                    <Setter Property="TextColor" Value="{x:Static t:AppColors.TextSecondary}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- Aucun départ -->
        <c:EmptyState Grid.Row="2" IsVisible="{Binding IsEmpty}"
                      Illustration="illus_no_trips.png"
                      Title="Aucun départ ce jour"
                      Message="{Binding EmptyMessage}"
                      ActionText="{Binding NextDayText}"
                      ActionVariant="Outlined"
                      ActionCommand="{Binding ShowNextDayCommand}" />

        <!-- Erreur -->
        <c:EmptyState Grid.Row="2" IsVisible="{Binding IsError}"
                      Illustration="illus_offline.png"
                      Title="Recherche impossible"
                      Message="{Binding ErrorMessage}"
                      ActionText="Réessayer"
                      ActionCommand="{Binding RetryCommand}" />
    </Grid>
</ContentPage>
