<?xml version="1.0" encoding="utf-8" ?>
<!-- Onglet « Rechercher » : en-tête bleu, formulaire, prochain départ, lignes populaires, recherches récentes. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:BusTicket.Controls"
             xmlns:h="clr-namespace:BusTicket.Helpers"
             xmlns:s="clr-namespace:BusTicket.Services"
             xmlns:t="clr-namespace:BusTicket.Theme"
             xmlns:vm="clr-namespace:BusTicket.ViewModels"
             x:Class="BusTicket.Views.Search.SearchPage"
             x:DataType="vm:SearchViewModel"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto">
            <!-- En-tête -->
            <Grid Style="{StaticResource HeaderBand}" RowDefinitions="Auto,Auto" Padding="20,44,20,64">
                <Image Grid.RowSpan="2" Source="illus_hero.png" Aspect="AspectFit" HeightRequest="120"
                       HorizontalOptions="End" VerticalOptions="End" Opacity="0.22" Margin="0,0,-40,-56" />
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="4" c:Motion.Entrance="FadeUp">
                        <Label Text="{Binding Greeting}" Style="{StaticResource Headline}" TextColor="White" />
                        <Label Text="Où voyagez-vous aujourd'hui ?" Style="{StaticResource OnPrimaryMuted}" FontSize="15" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                            BackgroundColor="{x:Static t:AppColors.PrimaryDark}" VerticalOptions="Start">
                        <Label Text="{Binding Initials}" FontFamily="RobotoBold" FontSize="16" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Grid>

            <!-- Formulaire, à cheval sur l'en-tête -->
            <VerticalStackLayout Grid.Row="1" Padding="16,0" Margin="0,-48,0,0" Spacing="16">
                <Border Style="{StaticResource Card}" Padding="16" c:Motion.Entrance="FadeUp" c:Motion.Delay="80">
                    <VerticalStackLayout Spacing="14">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                            <c:AppSelectField Label="Départ" Placeholder="Ville de départ"
                                              Icon="{x:Static h:MaterialIcons.TripOrigin}"
                                              Value="{Binding From}" Command="{Binding PickFromCommand}" />
                            <c:AppSelectField Grid.Row="1" Label="Arrivée" Placeholder="Ville d'arrivée"
                                              Icon="{x:Static h:MaterialIcons.Location}"
                                              Value="{Binding To}" ErrorText="{Binding ArrivalError}"
                                              Command="{Binding PickToCommand}" />

                            <!-- Bouton qui inverse départ et arrivée, à cheval sur les deux champs -->
                            <Border x:Name="SwapButton" Grid.RowSpan="2" WidthRequest="40" HeightRequest="40"
                                    HorizontalOptions="End" VerticalOptions="Start" Margin="0,64,14,0"
                                    Stroke="{x:Static t:AppColors.Divider}" BackgroundColor="White"
                                    StrokeShape="RoundRectangle 6"
                                    SemanticProperties.Description="Inverser départ et arrivée">
                                <Label Text="{x:Static h:MaterialIcons.SwapVert}" Style="{StaticResource Icon}"
                                       TextColor="{x:Static t:AppColors.Primary}" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSwapTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <c:AppDateField Label="Date" Date="{Binding Date}" />
                            <c:AppSelectField Grid.Column="1" Label="Passagers"
                                              Icon="{x:Static h:MaterialIcons.People}"
                                              Value="{Binding PassengersText}" Command="{Binding PickPassengersCommand}" />
                        </Grid>

                        <!-- Raccourcis de date -->
                        <HorizontalStackLayout Spacing="8">
                            <Border StrokeShape="RoundRectangle 4" Padding="12,6" Stroke="{x:Static t:AppColors.Divider}"
                                    BackgroundColor="White">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{x:Static t:AppColors.PrimarySoft}" />
                                        <Setter Property="Stroke" Value="{x:Static t:AppColors.Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="Aujourd'hui" Style="{StaticResource Small}" FontFamily="RobotoMedium" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetTodayCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                            <Border StrokeShape="RoundRectangle 4" Padding="12,6" Stroke="{x:Static t:AppColors.Divider}"
                                    BackgroundColor="White">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsTomorrow}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{x:Static t:AppColors.PrimarySoft}" />
                                        <Setter Property="Stroke" Value="{x:Static t:AppColors.Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="Demain" Style="{StaticResource Small}" FontFamily="RobotoMedium" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetTomorrowCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </HorizontalStackLayout>

                        <c:AppButton Text="Rechercher un bus" Icon="{x:Static h:MaterialIcons.Search}"
                                     IsEnabled="{Binding CanSearch}" Command="{Binding SearchCommand}" />
                    </VerticalStackLayout>
                </Border>

                <c:OfflineBanner />

                <!-- Prochain départ -->
                <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasNextTrip}"
                        c:Motion.Entrance="FadeUp" c:Motion.Delay="140">
                    <Grid ColumnDefinitions="6,Auto,*,Auto" ColumnSpacing="12">
                        <BoxView Color="{x:Static t:AppColors.Success}" />
                        <Border Grid.Column="1" Style="{StaticResource IconTile}" BackgroundColor="{x:Static t:AppColors.SuccessSoft}"
                                Margin="0,14">
                            <Label Text="{x:Static h:MaterialIcons.QrCode}" Style="{StaticResource Icon}"
                                   TextColor="{x:Static t:AppColors.Success}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                            <Label Text="Votre prochain départ" Style="{StaticResource Overline}" />
                            <Label Text="{Binding NextTripRoute}" Style="{StaticResource Value}" />
                            <Label Text="{Binding NextTripWhen}" Style="{StaticResource Small}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Label Grid.Column="3" Text="{x:Static h:MaterialIcons.ChevronRight}" Style="{StaticResource Icon}"
                               Margin="0,0,12,0" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenNextTripCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Lignes populaires et recherches récentes -->
            <VerticalStackLayout Grid.Row="2" Padding="16,24,16,24" Spacing="12">
                <Label Text="Lignes populaires" Style="{StaticResource Section}" />
                <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding PopularRoutes}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="s:RecentSearch">
                            <Border StrokeShape="RoundRectangle 6" Stroke="{x:Static t:AppColors.Divider}" BackgroundColor="White"
                                    Padding="12,8" Margin="0,0,8,8" c:Motion.Entrance="Pop" c:Motion.Delay="120">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{x:Static h:MaterialIcons.Bus}" Style="{StaticResource Icon}" FontSize="16"
                                           TextColor="{x:Static t:AppColors.Primary}" />
                                    <Label Text="{Binding Route}" Style="{StaticResource Small}" FontFamily="RobotoMedium"
                                           TextColor="{x:Static t:AppColors.TextPrimary}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SearchRecentCommand, Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, x:DataType=vm:SearchViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Label Text="Recherches récentes" Style="{StaticResource Section}" Margin="0,8,0,0" />
                <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasRecent}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recent}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="s:RecentSearch">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" HeightRequest="56" Padding="16,0">
                                    <Label Text="{x:Static h:MaterialIcons.History}" Style="{StaticResource Icon}" FontSize="20" />
                                    <Label Grid.Column="1" Text="{Binding Route}" Style="{StaticResource Body}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{x:Static h:MaterialIcons.ChevronRight}" Style="{StaticResource Icon}"
                                           TextColor="{x:Static t:AppColors.Disabled}" />
                                    <BoxView Grid.ColumnSpan="3" Style="{StaticResource Divider}" VerticalOptions="End" Margin="-16,0" />
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SearchRecentCommand, Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, x:DataType=vm:SearchViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <c:EmptyState IsVisible="{Binding HasNoRecent}"
                              Illustration="illus_route.png"
                              Title="Aucune recherche récente"
                              Message="Vos derniers trajets apparaîtront ici pour les retrouver en un geste." />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
